rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function valid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title','summary','body','category','siteKeys','sources','status','createdAt','updatedAt','publishedAt'])
        && d.keys().hasAll(['title','summary','body','category','siteKeys','sources','status','createdAt','updatedAt','publishedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.summary is string && d.summary.size() > 0 && d.summary.size() <= 300
        && d.body is string && d.body.size() > 0 && d.body.size() <= 50000
        && d.category in ['학습 정보','사이트 활용']
        && d.status in ['draft','published']
        && d.siteKeys is list && d.siteKeys.size() <= 3
        && d.sources is list && d.sources.size() <= 10
        && (d.status == 'draft' || d.sources.size() > 0)
        && d.createdAt is timestamp && d.updatedAt == request.time
        && (d.publishedAt == null || d.publishedAt is timestamp)
        && (d.status == 'draft' || d.publishedAt is timestamp);
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /infoArticles/{id} {
      allow read: if admin() || resource.data.status == 'published';
      allow create: if admin() && valid() && request.resource.data.createdAt == request.time
        && (request.resource.data.publishedAt == null || request.resource.data.publishedAt == request.time);
      allow update: if admin() && valid()
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.publishedAt == resource.data.publishedAt
          || (resource.data.publishedAt == null && request.resource.data.publishedAt == request.time));
      allow delete: if false;
    }
  }
}
